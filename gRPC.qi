// qi-grpc —— 用 qi 写 gRPC 服务
//
// ── 这一层负责什么 ──────────────────────────────────────────────
//
// 运行时（标准库.gRPC / 标准库.协议）管协议：HTTP/2 分帧、trailers、
// protobuf ↔ JSON。这个包管**开发者看得见的那一面**：
//   · 按 .proto 注册方法，注册时就核对类型名，不等到线上被调用才发现拼错
//   · 处理函数收 JSON、回 JSON —— 业务代码里不出现 protobuf 这个词
//   · 错误按 gRPC 状态码回，不是塞进正常返回值里
//
// ── 用法 ────────────────────────────────────────────────────────
//
//   函数 说你好(调用: 整数, 请求JSON: 字符串) : 字符串 {
//       变量 请求: 整数 = J.解码(请求JSON);
//       变量 名: 字符串 = J.获取字符串(请求, "name");
//       如果 (字符串::字节长度(名) == 0) {
//           返回 出错(参数不对, "name 不能为空");
//       }
//       变量 回: 整数 = J.创建对象();
//       J.设置字符串(回, "message", "你好，" + 名);
//       返回 J.转字符串(回);
//   }
//
//   函数 入口() {
//       建服务("协议/greet.proto");        // 服务是进程级单例，没有句柄要传
//       注册("greet.Greeter/SayHello", 说你好);
//       跑("127.0.0.1", 47811);
//   }
//
// ── JSON 字段名按 protobuf 官方映射 ─────────────────────────────
//
// **是 lowerCamelCase，不是 .proto 里的 snake_case**：`served_at` 在 JSON
// 里叫 `servedAt`，int64 是**字符串**（"7" 不是 7），枚举是名字
// （"MOOD_HAPPY" 不是 1）。这不是我们的发明，是 proto3 JSON mapping 规范；
// 对面的 Go/Java 服务也这么认。拿不准就把消息 解码 出来打一眼。
包 gRPC;

导入 标准库.协议 作为 协议;
导入 标准库.gRPC 作为 运行时;
导入 标准库.字节切片 作为 切片;
导入 标准库.JSON 作为 J;
导入 标准库.列表 作为 列表库;
导入 标准库.字符串;
导入 标准库.输入输出 作为 IO;
导入 标准库.信号 作为 信号;

// ── gRPC 状态码（规范里的名字，中文写法）──────────────────────
//
// 只列常用的。全表见 https://grpc.io/docs/guides/status-codes/
公开 函数 正常() : 整数 { 返回 0; }
公开 函数 取消了() : 整数 { 返回 1; }
公开 函数 参数不对() : 整数 { 返回 3; }
公开 函数 超时了() : 整数 { 返回 4; }
公开 函数 找不到() : 整数 { 返回 5; }
公开 函数 已存在() : 整数 { 返回 6; }
公开 函数 没权限() : 整数 { 返回 7; }
公开 函数 资源耗尽() : 整数 { 返回 8; }
公开 函数 前提不满足() : 整数 { 返回 9; }
公开 函数 没实现() : 整数 { 返回 12; }
公开 函数 内部错误() : 整数 { 返回 13; }
公开 函数 用不了() : 整数 { 返回 14; }
公开 函数 没登录() : 整数 { 返回 16; }

// ── 服务对象 ────────────────────────────────────────────────────
//
// 一个 J 对象句柄：{"描述符":…, "方法":{方法全名 → 处理函数句柄}, ...}。
// 全局单例：运行时的分发回调是个裸函数指针，没地方挂 self。
// 一个进程跑一个 gRPC 服务端是常态，真要跑两个就是两个进程。
变量 描述符: 整数 = 0 - 1;
// 三个列表按**同一个下标**对齐：方法全名、签名（请求/响应类型）、处理函数。
// 为什么不用一张 JSON 映射：qi 的 JSON 里放不了函数值，而函数值只能进
// 指针列表。既然处理函数必须走列表，索性三个都走列表，一个下标查到底 ——
// 比「JSON 存名字、列表存函数、两边靠另一个映射串起来」少一层间接。
// 开不开服务端反射。默认**开** —— 反射让 grpcurl/grpcui 这类工具直接可用，
// 而它只暴露 .proto 里本来就要给客户端的东西（服务名、方法、消息结构），
// 不涉及任何数据。真要关（比如公网上不想让人枚举接口）调 关反射()。
变量 要反射: 整数 = 1;
// 当前服务器句柄，优雅停机要用
变量 服务器句柄: 整数 = 0 - 1;
变量 方法名表: 整数 = 0;
变量 签名表: 整数 = 0;
变量 处理表: 整数 = 0;
// 这个方法是一元还是流式。两种处理函数签名不同，分发时要认得出来。
变量 流式表: 整数 = 0;
// 拦截器链（指针列表）。形状照 qi-web 的中间件：函数(下一步, 调用句柄)。
变量 拦截器表: 整数 = 0;

// 出错标记：处理函数返回值以此开头 = 这不是正常响应而是一个错误。
// 用一个正常 JSON 绝不会以之开头的串（JSON 只会以 { [ " 数字 t f n 开头）。
函数 错误前缀() : 字符串 { 返回 "#GRPC-ERR#"; }

// 处理函数里出错就返回这个，别自己拼字符串
公开 函数 出错(状态码: 整数, 消息: 字符串) : 字符串 {
    返回 错误前缀() + 整数转字符串(状态码) + "\n" + 消息;
}

// 建服务：加载 .proto。失败返回 0（成功返回 1）。
//
// 多个 .proto 用逗号分隔；import 按 导入目录 解析，留空就按文件自己的目录。
公开 函数 建服务(协议文件: 字符串) : 整数 {
    返回 建服务带导入(协议文件, "");
}

公开 函数 建服务带导入(协议文件: 字符串, 导入目录: 字符串) : 整数 {
    描述符 = 协议.加载(协议文件, 导入目录);
    如果 (描述符 < 0) {
        IO.打印行("gRPC: 加载协议失败: " + 协议文件);
        返回 0;
    }
    方法名表 = 列表库::创建字符串列表();
    签名表 = 列表库::创建整数列表();
    处理表 = 列表库::创建指针列表();
    流式表 = 列表库::创建整数列表();
    拦截器表 = 列表库::创建指针列表();
    返回 1;
}

// ── 拦截器 ──────────────────────────────────────────────────────
//
// 形状跟 qi-web 的中间件一样：拿到「下一步」和调用句柄，自己决定要不要往下走。
//
//   函数 要令牌(下一步: 函数(整数): 整数, 调用: 整数) : 整数 {
//       变量 令牌: 字符串 = 元数据(调用, "authorization");
//       如果 (字符串::开始于(令牌, "Bearer ") == 0) {
//           返回 收尾出错(调用, 没登录(), "缺令牌");   // 不调下一步 = 拦住
//       }
//       变量 开始: 整数 = 时间.现在毫秒();
//       变量 结局: 整数 = 下一步(调用);                 // 放行
//       IO.打印行("耗时 " + 整数转字符串(时间.现在毫秒() - 开始));
//       返回 结局;
//   }
//   加拦截器(要令牌);
//
// **后加的先跑**（像洋葱一层层包）：加 A 再加 B，进来的顺序是 B → A → 处理函数。
// 一元和流式共用同一条链 —— 鉴权、日志、限流这些不该因为方法是不是流式而两套。
公开 函数 加拦截器(拦截器: 函数(函数(整数): 整数, 整数): 整数) : 整数 {
    如果 (拦截器表 <= 0) {
        IO.打印行("gRPC: 还没 建服务");
        返回 0;
    }
    列表库::添加指针(拦截器表, 拦截器);
    返回 1;
}

公开 函数 关反射() : 整数 { 要反射 = 0; 返回 1; }
公开 函数 开反射() : 整数 { 要反射 = 1; 返回 1; }

// 注册一个一元方法。方法全名形如 "greet.Greeter/SayHello"。
//
// **注册时就查 .proto**：方法名拼错、请求/响应类型对不上，在这里就报出来。
// 不这么做的话，错误要等到对面真来调用时才以 UNIMPLEMENTED 的形式出现，
// 而那一刻你看到的只是「客户端说没这个方法」，看不出是自己拼错了。
// 处理函数拿 **(调用句柄, 请求JSON)**：句柄不是摆设 —— 元数据、剩余预算、
// 对面还在不在，都得靠它。Go 的 gRPC 给每个 handler 传 ctx 是同一个道理。
公开 函数 注册(方法全名: 字符串, 处理函数: 函数(整数, 字符串): 字符串) : 整数 {
    如果 (描述符 < 0) {
        IO.打印行("gRPC: 还没 建服务");
        返回 0;
    }
    变量 斜杠: 整数 = 字符串::查找(方法全名, "/");
    如果 (斜杠 < 0) {
        IO.打印行("gRPC: 方法全名要写成 包.服务/方法，收到的是 " + 方法全名);
        返回 0;
    }
    变量 服务名: 字符串 = 字符串::子串(方法全名, 0, 斜杠);
    变量 方法名: 字符串 = 字符串::子串(方法全名, 斜杠 + 1,
                                      字符串::字节长度(方法全名) - 斜杠 - 1);

    变量 找到: 整数 = 查方法(服务名, 方法名);
    如果 (找到 <= 0) {
        IO.打印行("gRPC: 协议里没有 " + 方法全名 + "（看看 .proto 里的拼写）");
        返回 0;
    }

    列表库::添加字符串(方法名表, 方法全名);
    列表库::添加整数(签名表, 找到);
    列表库::添加指针(处理表, 处理函数);
    列表库::添加整数(流式表, 0);
    返回 1;
}

// 注册一个**流式**方法。处理函数拿的是调用句柄，自己收自己发：
//
//   函数 唠嗑(调用: 整数) : 整数 {
//       当 (真) {
//           变量 一条: 字符串 = 收一条(调用, 5000);
//           如果 (到头了(一条) == 1) { 跳出; }      // 客户端半关
//           如果 (字符串::字节长度(一条) == 0) { 继续; }  // 这轮没有，接着等
//           发一条(调用, 处理(一条));
//       }
//       返回 收尾好了(调用);
//   }
//
// 三种流（服务端流 / 客户端流 / 双向）在这一层是**同一件事**：
// 收几条、发几条由你自己决定，.proto 里的 stream 标记只影响客户端怎么用。
公开 函数 注册流式(方法全名: 字符串, 处理函数: 函数(整数): 整数) : 整数 {
    如果 (描述符 < 0) {
        IO.打印行("gRPC: 还没 建服务");
        返回 0;
    }
    变量 斜杠: 整数 = 字符串::查找(方法全名, "/");
    如果 (斜杠 < 0) { 返回 0; }
    变量 找到: 整数 = 查方法(字符串::子串(方法全名, 0, 斜杠),
                            字符串::子串(方法全名, 斜杠 + 1,
                                        字符串::字节长度(方法全名) - 斜杠 - 1));
    如果 (找到 <= 0) {
        IO.打印行("gRPC: 协议里没有 " + 方法全名);
        返回 0;
    }
    列表库::添加字符串(方法名表, 方法全名);
    列表库::添加整数(签名表, 找到);
    列表库::添加指针(处理表, 处理函数);
    列表库::添加整数(流式表, 1);
    返回 1;
}

// ── 流式处理函数里用的几个 ────────────────────────────────────
//
// 收一条 返回请求 JSON；**空串 = 这轮没有（接着等）**，
// 到头了() = 客户端半关（该退出循环）。两者分开是必须的 ——
// 混成一个值，循环要么提前收摊要么永远转下去。
公开 函数 收一条(调用句柄: 整数, 超时毫秒: 整数) : 字符串 {
    变量 签名: 整数 = 当前签名(调用句柄);
    如果 (签名 <= 0) { 返回 到头标记(); }
    变量 缓冲: 整数 = 运行时.收一条(调用句柄, 超时毫秒);
    如果 (缓冲 < 0) { 返回 到头标记(); }
    如果 (缓冲 == 0) { 返回 ""; }
    变量 出: 字符串 = 协议.解码(描述符, J.获取字符串(签名, "请求"), 缓冲);
    切片.释放切片(缓冲);
    返回 出;
}

函数 到头标记() : 字符串 { 返回 "#GRPC-EOF#"; }

公开 函数 到头了(一条: 字符串) : 整数 {
    返回 字符串::等于(一条, 到头标记());
}

公开 函数 发一条(调用句柄: 整数, 响应JSON: 字符串) : 整数 {
    变量 签名: 整数 = 当前签名(调用句柄);
    如果 (签名 <= 0) { 返回 -1; }
    变量 缓冲: 整数 = 协议.编码(描述符, J.获取字符串(签名, "响应"), 响应JSON);
    如果 (缓冲 < 0) {
        IO.打印行("gRPC: 响应编不出来: " + 协议.最后错误(描述符));
        返回 -1;
    }
    变量 结局: 整数 = 运行时.发一条(调用句柄, 缓冲);
    切片.释放切片(缓冲);
    返回 结局;
}

公开 函数 收尾好了(调用句柄: 整数) : 整数 {
    返回 运行时.收尾(调用句柄, 正常(), "");
}

公开 函数 收尾出错(调用句柄: 整数, 状态码: 整数, 消息: 字符串) : 整数 {
    返回 运行时.收尾(调用句柄, 状态码, 消息);
}

// 对面还在吗。1 = 还连着，0 = 已经断了。
//
// 长活儿中途问一句：人都走了就别算了。**这跟「收一条到头了」不是一回事** ——
// 那个的含义是「客户端发完了」，一元和客户端流的正常路径每次都会走到。
公开 函数 还活着(调用句柄: 整数) : 整数 {
    返回 运行时.还活着(调用句柄);
}

// 这条调用还剩多少毫秒预算（上游 grpc-timeout 给的）。没有信息返回 -1。
//
// 长活儿动手前问一句：只剩两百毫秒就别开工了，干完也没人要。
公开 函数 剩余预算(调用句柄: 整数) : 整数 {
    返回 运行时.剩余预算(调用句柄);
}

// 这条调用打的是哪个方法 —— 拦截器里按方法分流要用
公开 函数 方法名(调用句柄: 整数) : 字符串 {
    返回 运行时.方法名(调用句柄);
}

// ── 元数据 ──────────────────────────────────────────────────────
//
// 鉴权、链路追踪、租户标识全靠它。**键按小写查** —— HTTP/2 的头名一律小写，
// 对面写 `Authorization` 到这儿就是 `authorization`（这里会自动转小写，
// 传什么大小写都行）。
公开 函数 元数据(调用句柄: 整数, 键: 字符串) : 字符串 {
    返回 运行时.元数据(调用句柄, 键);
}

// 全部请求元数据，JSON 对象
公开 函数 全部元数据(调用句柄: 整数) : 字符串 {
    返回 运行时.全部元数据(调用句柄);
}

// 往响应的 trailers 里塞一条自定义元数据（收尾时一起发）。
// `grpc-` 前缀和伪头不给用 —— 那是协议自己的地盘，塞进去会把状态搞乱。
公开 函数 设响应元数据(调用句柄: 整数, 键: 字符串, 值: 字符串) : 整数 {
    返回 运行时.设响应元数据(调用句柄, 键, 值);
}

// 当前这条调用对应的方法签名。流式处理函数里要用（编解码得知道类型）。
函数 当前签名(调用句柄: 整数) : 整数 {
    变量 下标: 整数 = 找下标(运行时.方法名(调用句柄));
    如果 (下标 < 0) { 返回 0; }
    返回 列表库::获取整数(签名表, 下标);
}

// 在描述符里找这个方法，返回一个带请求/响应类型名的对象句柄；没有返回 0。
函数 查方法(服务名: 字符串, 方法名: 字符串) : 整数 {
    变量 表: 整数 = J.解码(协议.服务表(描述符));
    变量 出: 整数 = 0;
    变量 i: 整数 = 0;
    变量 n: 整数 = J.数组长度(表);
    当 (i < n) {
        变量 一个服务: 整数 = J.数组获取对象(表, i);
        如果 (字符串::等于(J.获取字符串(一个服务, "服务"), 服务名) == 1) {
            变量 方法们: 整数 = J.获取数组(一个服务, "方法");
            变量 k: 整数 = 0;
            变量 m: 整数 = J.数组长度(方法们);
            当 (k < m) {
                变量 一个方法: 整数 = J.数组获取对象(方法们, k);
                如果 (字符串::等于(J.获取字符串(一个方法, "名"), 方法名) == 1) {
                    出 = J.创建对象();
                    J.设置字符串(出, "请求", J.获取字符串(一个方法, "请求"));
                    J.设置字符串(出, "响应", J.获取字符串(一个方法, "响应"));
                    J.设置整数(出, "客户端流", J.获取整数(一个方法, "客户端流"));
                    J.设置整数(出, "服务端流", J.获取整数(一个方法, "服务端流"));
                    k = m;
                }
                k = k + 1;
            }
            i = n;
        }
        i = i + 1;
    }
    J.删除(表);
    返回 出;
}

// ── 处理一条调用 ────────────────────────────────────────────────
//
// 从运行时拿到调用句柄，查方法、解请求、调处理函数、编响应、回复。
// 每条调用**必须回复**（哪怕是错），不回复的话客户端一直等到超时，
// 而服务端这边一点痕迹都没有。
公开 函数 处理一条(调用句柄: 整数) : 整数 {
    // 从最里层（真处理函数）往外套，所以后加的拦截器在最外面、最先跑
    变量 链: 函数(整数): 整数 = 真处理;
    变量 i: 整数 = 0;
    变量 n: 整数 = 列表库::指针列表大小(拦截器表);
    当 (i < n) {
        变量 这一层: 函数(函数(整数): 整数, 整数): 整数 = 列表库::获取指针(拦截器表, i);
        变量 里面: 函数(整数): 整数 = 链;
        链 = 闭包(调用: 整数): 整数 {
            返回 这一层(里面, 调用);
        };
        i = i + 1;
    }
    返回 链(调用句柄);
}

函数 真处理(调用句柄: 整数) : 整数 {
    变量 方法全名: 字符串 = 运行时.方法名(调用句柄);
    变量 下标: 整数 = 找下标(方法全名);
    如果 (下标 < 0) {
        返回 运行时.回复(调用句柄, 没实现(), "没有这个方法: " + 方法全名, 0);
    }

    // 流式方法：把调用句柄整个交给处理函数，收发和收尾都它自己来
    如果 (列表库::获取整数(流式表, 下标) == 1) {
        变量 流处理: 函数(整数): 整数 = 列表库::获取指针(处理表, 下标);
        返回 流处理(调用句柄);
    }

    // **请求字节 必须在流式判断之后取**：它会阻塞着等第一条消息并把它
    // 从队列里取走。放在前面的话，流式方法永远少收第一条 —— 症状是
    // 「客户端发 3 条服务端只见到 2 条」，而且第一条静悄悄地没了。
    变量 请求字节: 整数 = 运行时.请求字节(调用句柄);

    变量 签名: 整数 = 列表库::获取整数(签名表, 下标);
    变量 请求类型: 字符串 = J.获取字符串(签名, "请求");
    变量 响应类型: 字符串 = J.获取字符串(签名, "响应");

    // 线格式 → JSON。解不开就是对面发的东西不合这份 .proto。
    变量 请求JSON: 字符串 = 协议.解码(描述符, 请求类型, 请求字节);
    如果 (字符串::字节长度(请求JSON) == 0) {
        返回 运行时.回复(调用句柄, 参数不对(),
                        "请求解不开: " + 协议.最后错误(描述符), 0);
    }

    变量 处理函数: 函数(整数, 字符串): 字符串 = 列表库::获取指针(处理表, 下标);
    变量 回复JSON: 字符串 = 处理函数(调用句柄, 请求JSON);

    // 处理函数用 出错() 报的错
    如果 (字符串::开始于(回复JSON, 错误前缀()) == 1) {
        变量 剩下: 字符串 = 字符串::子串(回复JSON, 字符串::字节长度(错误前缀()),
                                        字符串::字节长度(回复JSON) - 字符串::字节长度(错误前缀()));
        变量 换行: 整数 = 字符串::查找(剩下, "\n");
        变量 码: 整数 = 内部错误();
        变量 话: 字符串 = 剩下;
        如果 (换行 >= 0) {
            码 = 字符串转整数(字符串::子串(剩下, 0, 换行));
            话 = 字符串::子串(剩下, 换行 + 1, 字符串::字节长度(剩下) - 换行 - 1);
        }
        返回 运行时.回复(调用句柄, 码, 话, 0);
    }

    // JSON → 线格式。编不出来多半是业务代码填错了字段名
    // （snake_case 写成了 lowerCamelCase 之外的东西，或者字段名压根不存在）。
    变量 响应字节: 整数 = 协议.编码(描述符, 响应类型, 回复JSON);
    如果 (响应字节 < 0) {
        返回 运行时.回复(调用句柄, 内部错误(),
                        "响应编不出来: " + 协议.最后错误(描述符), 0);
    }
    变量 结局: 整数 = 运行时.回复(调用句柄, 正常(), "", 响应字节);
    切片.释放切片(响应字节);
    返回 结局;
}

// 起服务端（明文 h2c）并进入循环。阻塞。
//
// 为什么默认明文：gRPC 大量跑在内网和 sidecar 后面，那些场景本来就是 h2c；
// 浏览器不支持 h2c 也没关系 —— 浏览器本来就不能直接说 gRPC（要 grpc-web）。
公开 函数 跑(主机: 字符串, 端口: 整数) : 整数 {
    返回 跑起来(运行时.监听(主机, 端口), 主机, 端口, "明文 h2c");
}

// 起 TLS 服务端。证书和私钥是 PEM 路径。
//
// ALPN 只报 h2 —— gRPC 只跑 HTTP/2。给 http/1.1 兜底只会让配错的客户端
// 拿到一个更难懂的错（协商成 1.1 之后所有 gRPC 帧都没人认）。
公开 函数 跑TLS(主机: 字符串, 端口: 整数, 证书路径: 字符串, 私钥路径: 字符串) : 整数 {
    返回 跑起来(运行时.监听TLS(主机, 端口, 证书路径, 私钥路径), 主机, 端口, "TLS");
}

函数 跑起来(服务器: 整数, 主机: 字符串, 端口: 整数, 怎么跑: 字符串) : 整数 {
    如果 (描述符 < 0) {
        IO.打印行("gRPC: 还没 建服务");
        返回 0;
    }
    如果 (服务器 < 0) {
        IO.打印行("gRPC: 监听 " + 主机 + ":" + 整数转字符串(端口) + " 失败");
        返回 0;
    }
    变量 反射说明: 字符串 = "";
    服务器句柄 = 服务器;
    如果 (要反射 == 1) {
        运行时.开反射(服务器, 描述符);
        反射说明 = "、带反射";
    }
    IO.打印行("gRPC 服务端: " + 主机 + ":" + 整数转字符串(端口)
             + "（" + 怎么跑 + 反射说明 + "）");
    列出已注册();

    // 收到 SIGTERM/SIGINT 就优雅停机 —— 直接退出的话在途请求会被拦腰截断，
    // 客户端看到的是连接重置而不是一个体面的状态码。滚动发布时这种截断
    // 集中出现，就是「每次发版都有一小撮 5xx」。
    信号.安装关闭处理();

    // 超时收（2 秒）而不是死等：循环得能周期性醒过来，才有机会看信号、
    // 也才能在没请求的间隙干别的。收到 0 就是这一轮没请求。
    当 (真) {
        如果 (信号.应关闭() == 1) {
            IO.打印行("收到停机信号，等在途调用做完…");
            变量 剩: 整数 = 优雅停机(10000);
            如果 (剩 > 0) {
                IO.打印行("还有 " + 整数转字符串(剩) + " 条没做完，不等了");
            } 否则 {
                IO.打印行("在途调用都做完了");
            }
            返回 1;
        }
        变量 调用: 整数 = 运行时.接收调用(服务器, 2000);
        如果 (调用 > 0) {
            // 每条调用一个 goroutine：处理函数里查库、调 LLM 都是常事，
            // 串行跑的话一条慢调用会把后面所有人堵住。
            启动 处理一条(调用);
        }
    }
    返回 1;
}

// 优雅停机：不再收新连接，等在途调用做完（最多等 N 毫秒），返回没做完的条数。
//
// 直接退出的话在途请求会被拦腰截断，客户端看到的是连接重置而不是一个体面的
// 状态码。滚动发布时这种截断会集中出现，表现为「每次发版都有一小撮 5xx」。
公开 函数 优雅停机(最多等毫秒: 整数) : 整数 {
    如果 (服务器句柄 < 0) { 返回 0; }
    变量 剩: 整数 = 运行时.停止(服务器句柄, 最多等毫秒);
    服务器句柄 = 0 - 1;
    返回 剩;
}

// 线性找。方法数是个位数到几十，线性扫比建索引省事，也不会成为瓶颈 ——
// 真正的开销在 protobuf 编解码和网络上。
函数 找下标(方法全名: 字符串) : 整数 {
    变量 i: 整数 = 0;
    变量 n: 整数 = 列表库::字符串列表大小(方法名表);
    当 (i < n) {
        如果 (字符串::等于(列表库::获取字符串(方法名表, i), 方法全名) == 1) {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

函数 列出已注册() {
    变量 i: 整数 = 0;
    变量 n: 整数 = 列表库::字符串列表大小(方法名表);
    当 (i < n) {
        IO.打印行("  · " + 列表库::获取字符串(方法名表, i));
        i = i + 1;
    }
}

// ── 客户端 ──────────────────────────────────────────────────────
//
// 一条连接多路复用，所以**连一次、句柄留着反复用**。每次调用都重连的话，
// 每次都要付 TCP + HTTP/2 握手的钱，连接数也会一路涨上去。
//
//   变量 连: 整数 = 连接后端("127.0.0.1:47811");
//   变量 回: 字符串 = 调用(连, "greet.Greeter/SayHello", "{\"name\":\"世界\"}");
//   如果 (是错误(回) == 1) { IO.打印行(错误说明(回)); }
//
// 客户端也要有一份 .proto（建服务 加载的那份就行）—— 编解码要靠它。

公开 函数 连接后端(地址: 字符串) : 整数 {
    返回 运行时.连接(地址);
}

// 连 TLS 后端。CA 留空走系统内置根证书；自签证书把 CA 的 PEM 路径传进来。
公开 函数 连接后端TLS(地址: 字符串, CA路径: 字符串) : 整数 {
    返回 运行时.连接TLS(地址, CA路径);
}

// 各后端的健康状况，JSON 数组：[{"地址":…,"连着":真,"连续失败":0,"退避中":假}]
//
// 排查「请求怎么都跑到一台上去了」的时候看它 —— 挂掉的后端会显示成
// 退避中，而不是一直被轮到再失败一次。
公开 函数 后端状况(连接句柄: 整数) : 字符串 {
    返回 运行时.后端状况(连接句柄);
}

公开 函数 断开后端(连接句柄: 整数) : 整数 {
    返回 运行时.断开(连接句柄);
}

// 给连接设一组默认元数据（JSON 对象），之后每次调用都带上。
//
// auth token 这类每次都要带的东西放这儿 —— 靠每个调用点自己记得传的话，
// 漏一个就是一次 401，而且是那种「大部分时候好使」的漏。
//
//   设默认元数据(连, "{\"authorization\":\"Bearer xxx\"}");
公开 函数 设默认元数据(连接句柄: 整数, 元数据JSON: 字符串) : 整数 {
    返回 运行时.设默认元数据(连接句柄, 元数据JSON);
}

// 发一次一元调用。返回响应 JSON；出错时返回 出错() 那种带前缀的串，
// 用 是错误() / 错误码() / 错误说明() 拆。
//
// 为什么不抛异常：qi 的异常要跨 goroutine 传得小心，而 RPC 失败是**常态**
// 不是意外（对面重启、网络抖动），走返回值调用方更难忽略。
公开 函数 调用(连接句柄: 整数, 方法全名: 字符串, 请求JSON: 字符串) : 字符串 {
    返回 调用带超时(连接句柄, 方法全名, 请求JSON, 30000);
}

// 带调用级元数据（同名盖掉连接级默认）
公开 函数 调用带元数据(连接句柄: 整数, 方法全名: 字符串, 请求JSON: 字符串,
                       元数据JSON: 字符串) : 字符串 {
    返回 调用全参(连接句柄, 方法全名, 请求JSON, 30000, 元数据JSON);
}

公开 函数 调用带超时(连接句柄: 整数, 方法全名: 字符串, 请求JSON: 字符串,
                     超时毫秒: 整数) : 字符串 {
    返回 调用全参(连接句柄, 方法全名, 请求JSON, 超时毫秒, "");
}

公开 函数 调用全参(连接句柄: 整数, 方法全名: 字符串, 请求JSON: 字符串,
                   超时毫秒: 整数, 元数据JSON: 字符串) : 字符串 {
    本次连接 = 连接句柄;
    本次超时 = 超时毫秒;
    本次元数据 = 元数据JSON;

    // 从最里层（真发出去）往外套，后加的拦截器在最外面、最先跑
    变量 链: 函数(字符串, 字符串): 字符串 = 真发一次;
    变量 层: 整数 = 0;
    变量 共几层: 整数 = 0;
    如果 (客户端拦截器表 > 0) {
        共几层 = 列表库::指针列表大小(客户端拦截器表);
    }
    当 (层 < 共几层) {
        变量 这一层: 函数(函数(字符串, 字符串): 字符串, 字符串, 字符串): 字符串
            = 列表库::获取指针(客户端拦截器表, 层);
        变量 里面: 函数(字符串, 字符串): 字符串 = 链;
        链 = 闭包(方法: 字符串, 请求: 字符串): 字符串 {
            返回 这一层(里面, 方法, 请求);
        };
        层 = 层 + 1;
    }
    返回 链(方法全名, 请求JSON);
}

函数 真发一次(方法全名: 字符串, 请求JSON: 字符串) : 字符串 {
    变量 连接句柄: 整数 = 本次连接;
    变量 超时毫秒: 整数 = 本次超时;
    变量 元数据JSON: 字符串 = 本次元数据;
    如果 (描述符 < 0) {
        返回 出错(内部错误(), "还没 建服务（客户端也要加载 .proto 才能编解码）");
    }
    变量 签名: 整数 = 查方法全名(方法全名);
    如果 (签名 <= 0) {
        返回 出错(没实现(), "协议里没有 " + 方法全名);
    }
    变量 请求类型: 字符串 = J.获取字符串(签名, "请求");
    变量 响应类型: 字符串 = J.获取字符串(签名, "响应");

    变量 请求字节: 整数 = 协议.编码(描述符, 请求类型, 请求JSON);
    如果 (请求字节 < 0) {
        返回 出错(参数不对(), "请求编不出来: " + 协议.最后错误(描述符));
    }

    变量 结果句柄: 整数 = 运行时.调用带元数据(连接句柄, 方法全名, 请求字节,
                                            超时毫秒, 元数据JSON);
    切片.释放切片(请求字节);
    如果 (结果句柄 < 0) {
        返回 出错(用不了(), "连接句柄无效");
    }

    变量 状态: 整数 = 运行时.结果状态(结果句柄);
    如果 (状态 != 正常()) {
        变量 说明: 字符串 = 运行时.结果消息(结果句柄);
        运行时.结果释放(结果句柄);
        返回 出错(状态, 说明);
    }

    变量 响应字节: 整数 = 运行时.结果字节(结果句柄);
    变量 响应JSON: 字符串 = 协议.解码(描述符, 响应类型, 响应字节);
    运行时.结果释放(结果句柄);
    如果 (字符串::字节长度(响应JSON) == 0) {
        返回 出错(内部错误(), "响应解不开: " + 协议.最后错误(描述符));
    }
    返回 响应JSON;
}

// 调用 的返回值是不是一个错误
公开 函数 是错误(返回值: 字符串) : 整数 {
    返回 字符串::开始于(返回值, 错误前缀());
}

公开 函数 错误码(返回值: 字符串) : 整数 {
    如果 (是错误(返回值) == 0) { 返回 正常(); }
    变量 剩下: 字符串 = 去前缀(返回值);
    变量 换行: 整数 = 字符串::查找(剩下, "\n");
    如果 (换行 < 0) { 返回 内部错误(); }
    返回 字符串转整数(字符串::子串(剩下, 0, 换行));
}

公开 函数 错误说明(返回值: 字符串) : 字符串 {
    如果 (是错误(返回值) == 0) { 返回 ""; }
    变量 剩下: 字符串 = 去前缀(返回值);
    变量 换行: 整数 = 字符串::查找(剩下, "\n");
    如果 (换行 < 0) { 返回 剩下; }
    返回 字符串::子串(剩下, 换行 + 1, 字符串::字节长度(剩下) - 换行 - 1);
}

函数 去前缀(返回值: 字符串) : 字符串 {
    变量 前缀长: 整数 = 字符串::字节长度(错误前缀());
    返回 字符串::子串(返回值, 前缀长, 字符串::字节长度(返回值) - 前缀长);
}

// 按 "包.服务/方法" 找签名。跟 注册 用的是同一条查法，只是那边拆好了才查。
函数 查方法全名(方法全名: 字符串) : 整数 {
    变量 斜杠: 整数 = 字符串::查找(方法全名, "/");
    如果 (斜杠 < 0) { 返回 0; }
    返回 查方法(字符串::子串(方法全名, 0, 斜杠),
                字符串::子串(方法全名, 斜杠 + 1,
                            字符串::字节长度(方法全名) - 斜杠 - 1));
}

// ── 客户端拦截器 ────────────────────────────────────────────────
//
// 跟服务端那条一样的形状，只是穿的是「一次调用」而不是「一条请求」：
//
//   函数 打点(下一步: 函数(字符串, 字符串): 字符串,
//            方法: 字符串, 请求JSON: 字符串) : 字符串 {
//       变量 开始: 整数 = 时间.现在毫秒();
//       变量 回: 字符串 = 下一步(方法, 请求JSON);
//       IO.打印行(方法 + " 用了 " + 整数转字符串(时间.现在毫秒() - 开始));
//       返回 回;
//   }
//   加客户端拦截器(打点);
//
// **后加的先跑**，跟服务端一致。不调「下一步」就是短路（本地缓存、
// 熔断、灰度挡板都靠这个）。
变量 客户端拦截器表: 整数 = 0;

公开 函数 加客户端拦截器(拦截器: 函数(函数(字符串, 字符串): 字符串,
                                     字符串, 字符串): 字符串) : 整数 {
    如果 (客户端拦截器表 <= 0) {
        客户端拦截器表 = 列表库::创建指针列表();
    }
    列表库::添加指针(客户端拦截器表, 拦截器);
    返回 1;
}

// 当前这一轮调用的连接和参数 —— 拦截器链是按 (方法, 请求JSON) 串起来的，
// 连接和超时这些不变的东西放这儿，免得每层都要透传。
变量 本次连接: 整数 = 0;
变量 本次超时: 整数 = 30000;
变量 本次元数据: 字符串 = "";

// ── 客户端流式 ──────────────────────────────────────────────────
//
// 三种流在这一层是同一件事 —— 发几条、收几条你自己定：
//
//   变量 流: 整数 = 开流(连, "greet.Greeter/Chatter");
//   流发(流, "{\"name\":\"甲\"}");
//   变量 一条: 字符串 = 流收(流, 5000);
//   半关掉(流);                       // 客户端流**必须**半关
//   当 (真) {
//       变量 再来: 字符串 = 流收(流, 5000);
//       如果 (流到头了(再来) == 1) { 跳出; }
//   }
//   如果 (流出错了(流) == 1) { IO.打印行(流的说明(流)); }
//   关掉流(流);

公开 函数 开流(连接句柄: 整数, 方法全名: 字符串) : 整数 {
    返回 开流带超时(连接句柄, 方法全名, 300000);
}

公开 函数 开流带超时(连接句柄: 整数, 方法全名: 字符串, 超时毫秒: 整数) : 整数 {
    如果 (描述符 < 0) {
        IO.打印行("gRPC: 还没 建服务（客户端也要加载 .proto）");
        返回 -1;
    }
    如果 (查方法全名(方法全名) <= 0) {
        IO.打印行("gRPC: 协议里没有 " + 方法全名);
        返回 -1;
    }
    变量 流: 整数 = 运行时.开流(连接句柄, 方法全名, 超时毫秒);
    如果 (流 >= 0) {
        记住流的方法(流, 方法全名);
    }
    返回 流;
}

// 流句柄 → 方法全名。编解码要按方法查请求/响应类型，而运行时那侧
// 只认句柄不认协议。
变量 流句柄表: 整数 = 0;
变量 流方法表: 整数 = 0;

函数 记住流的方法(流: 整数, 方法全名: 字符串) {
    如果 (流句柄表 <= 0) {
        流句柄表 = 列表库::创建整数列表();
        流方法表 = 列表库::创建字符串列表();
    }
    列表库::添加整数(流句柄表, 流);
    列表库::添加字符串(流方法表, 方法全名);
}

函数 流的方法(流: 整数) : 字符串 {
    如果 (流句柄表 <= 0) { 返回 ""; }
    变量 i: 整数 = 0;
    变量 n: 整数 = 列表库::整数列表大小(流句柄表);
    当 (i < n) {
        如果 (列表库::获取整数(流句柄表, i) == 流) {
            返回 列表库::获取字符串(流方法表, i);
        }
        i = i + 1;
    }
    返回 "";
}

公开 函数 流发(流: 整数, 请求JSON: 字符串) : 整数 {
    变量 签名: 整数 = 查方法全名(流的方法(流));
    如果 (签名 <= 0) { 返回 -1; }
    变量 缓冲: 整数 = 协议.编码(描述符, J.获取字符串(签名, "请求"), 请求JSON);
    如果 (缓冲 < 0) {
        IO.打印行("gRPC: 请求编不出来: " + 协议.最后错误(描述符));
        返回 -1;
    }
    变量 结局: 整数 = 运行时.流发一条(流, 缓冲);
    切片.释放切片(缓冲);
    返回 结局;
}

// 客户端流**必须**半关，否则服务端一直等下一条，两边干瞪眼
公开 函数 半关掉(流: 整数) : 整数 {
    返回 运行时.半关(流);
}

// 收一条。空串 = 这轮没有（接着等）；流到头了() = 服务端收尾了。
公开 函数 流收(流: 整数, 超时毫秒: 整数) : 字符串 {
    变量 签名: 整数 = 查方法全名(流的方法(流));
    如果 (签名 <= 0) { 返回 到头标记(); }
    变量 缓冲: 整数 = 运行时.流收一条(流, 超时毫秒);
    如果 (缓冲 < 0) { 返回 到头标记(); }
    如果 (缓冲 == 0) { 返回 ""; }
    变量 出: 字符串 = 协议.解码(描述符, J.获取字符串(签名, "响应"), 缓冲);
    切片.释放切片(缓冲);
    返回 出;
}

公开 函数 流到头了(一条: 字符串) : 整数 {
    返回 到头了(一条);
}

// 服务端是不是以错误收尾的（收完之后再问）
公开 函数 流出错了(流: 整数) : 整数 {
    变量 码: 整数 = 运行时.流状态(流);
    如果 (码 <= 0) { 返回 0; }
    返回 1;
}

公开 函数 流的状态码(流: 整数) : 整数 {
    返回 运行时.流状态(流);
}

公开 函数 流的说明(流: 整数) : 字符串 {
    返回 运行时.流消息(流);
}

公开 函数 关掉流(流: 整数) : 整数 {
    返回 运行时.关流(流);
}
