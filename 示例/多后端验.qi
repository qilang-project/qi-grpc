// 多后端轮询 + 断线重连 + 重试。
//
//   # 起两个 Go 服务端
//   /tmp/gosrv -addr 127.0.0.1:47841 &
//   /tmp/gosrv -addr 127.0.0.1:47842 &
//   GRPC_ADDR=127.0.0.1:47841,127.0.0.1:47842 qi run 示例/多后端验.qi
//
// 中途会提示你杀掉其中一个 —— 杀掉之后请求要能自动落到活着的那个，
// 而不是一半请求失败。
包 主程序;

导入 gRPC::{建服务, 连接后端, 断开后端, 调用, 是错误, 错误码, 错误说明};
导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.时间 作为 时间;
导入 标准库.操作系统 作为 系统;
导入 标准库.输入输出 作为 IO;

函数 取或默认(键: 字符串, 默认值: 字符串) : 字符串 {
    变量 设的: 字符串 = 系统.获取环境变量(键);
    如果 (字符串::字节长度(设的) > 0) { 返回 设的; }
    返回 默认值;
}

// 每个后端把自己的地址放在 detail.server 里带回来，据此数出请求分到了哪几个
变量 见过的后端: 字符串 = "";

函数 打一轮(连: 整数, 几次: 整数) : 整数 {
    变量 成: 整数 = 0;
    变量 i: 整数 = 0;
    见过的后端 = "";
    当 (i < 几次) {
        变量 回: 字符串 = 调用(连, "greet.Greeter/SayHello", "{\"name\":\"轮询\"}");
        如果 (是错误(回) == 0) {
            成 = 成 + 1;
            变量 o: 整数 = J.解码(回);
            变量 明细: 整数 = J.获取对象(o, "detail");
            变量 谁: 字符串 = J.获取字符串(明细, "server");
            如果 (字符串::包含(见过的后端, 谁) == 0) {
                见过的后端 = 见过的后端 + 谁 + " ";
            }
            J.删除(o);
        } 否则 {
            IO.打印行("    第 " + 整数转字符串(i) + " 次失败: 码="
                     + 整数转字符串(错误码(回)) + " " + 错误说明(回));
        }
        i = i + 1;
    }
    返回 成;
}

函数 入口() {
    建服务(取或默认("GREET_PROTO", "协议/greet.proto"));
    变量 地址: 字符串 = 取或默认("GRPC_ADDR", "127.0.0.1:47841,127.0.0.1:47842");
    变量 连: 整数 = 连接后端(地址);
    如果 (连 < 0) { IO.打印行("连不上 " + 地址); 返回; }
    IO.打印行("连上 " + 地址);

    IO.打印行("两个后端都活着：");
    IO.打印行("  打 10 次成了 " + 整数转字符串(打一轮(连, 10)) + " 次");
    IO.打印行("  请求分到了这些后端: " + 见过的后端);

    // 杀掉一个后端之后：轮到那条子连接的请求会拿到 UNAVAILABLE，
    // 运行时把它标坏、退避、换另一条重试 —— 对上层应当是无感的
    变量 杀哪个: 字符串 = 系统.获取环境变量("KILL_PORT");
    如果 (字符串::字节长度(杀哪个) > 0) {
        IO.打印行("等 3 秒，这期间请把 " + 杀哪个 + " 那个后端杀掉…");
        时间.睡眠毫秒(3000);
        IO.打印行("少一个后端之后：");
        变量 成: 整数 = 打一轮(连, 10);
        IO.打印行("  打 10 次成了 " + 整数转字符串(成) + " 次");
        IO.打印行("  请求分到了这些后端: " + 见过的后端);
        如果 (成 == 10) {
            IO.打印行("  ✓ 掉一个后端，请求没有掉");
        } 否则 {
            IO.打印行("  ✗ 掉了 " + 整数转字符串(10 - 成) + " 次");
        }
    }

    断开后端(连);
}
