// qi 客户端的流式验证 —— 打任意实现了 greet.Greeter/Chatter 的服务端。
//
//   # 打 Go 服务端
//   cd 互通/go对照 && go run ./server -addr 127.0.0.1:47821 &
//   GRPC_ADDR=127.0.0.1:47821 qi run 示例/流式客户端.qi
//
//   # 打自家 qi 服务端
//   GRPC_ADDR=127.0.0.1:47813 qi run 示例/流式客户端.qi
包 主程序;

导入 gRPC::{建服务, 连接后端, 断开后端, 开流, 流发, 流收, 半关掉,
             流到头了, 流的状态码, 流的说明, 关掉流};
导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 标准库.输入输出 作为 IO;

变量 通过: 整数 = 0;
变量 失败: 整数 = 0;

函数 记(名: 字符串, 好: 整数, 详情: 字符串) {
    如果 (好 == 1) {
        通过 = 通过 + 1;
        IO.打印行("  ✓ " + 名 + "  " + 详情);
    } 否则 {
        失败 = 失败 + 1;
        IO.打印行("  ✗ " + 名 + "  " + 详情);
    }
}

函数 取或默认(键: 字符串, 默认值: 字符串) : 字符串 {
    变量 设的: 字符串 = 系统.获取环境变量(键);
    如果 (字符串::字节长度(设的) > 0) { 返回 设的; }
    返回 默认值;
}

函数 一条请求(名: 字符串) : 字符串 {
    变量 o: 整数 = J.创建对象();
    J.设置字符串(o, "name", 名);
    变量 出: 字符串 = J.转字符串(o);
    J.删除(o);
    返回 出;
}

函数 入口() {
    建服务(取或默认("GREET_PROTO", "协议/greet.proto"));
    变量 连: 整数 = 连接后端(取或默认("GRPC_ADDR", "127.0.0.1:47813"));
    如果 (连 < 0) { IO.打印行("连不上"); 返回; }

    // ── 双向：发一条收一条 ──
    变量 流: 整数 = 开流(连, "greet.Greeter/Chatter");
    如果 (流 < 0) { IO.打印行("开流失败"); 返回; }

    变量 收到: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 3) {
        流发(流, 一条请求("第" + 整数转字符串(i + 1) + "位"));
        // 发一条立刻收一条 —— 真双向，不是「全发完再全收」
        变量 一条: 字符串 = 流收(流, 5000);
        如果 (流到头了(一条) == 0 与 字符串::字节长度(一条) > 0) {
            收到 = 收到 + 1;
            如果 (i == 0) {
                变量 o: 整数 = J.解码(一条);
                IO.打印行("    头一条回的是: " + J.获取字符串(o, "message"));
                J.删除(o);
            }
        }
        i = i + 1;
    }
    记("双向流 发一条收一条 ×3", 收到 == 3, 整数转字符串(收到) + "/3");

    // ── 半关之后要能读到干净的收尾 ──
    半关掉(流);
    变量 尾: 字符串 = 流收(流, 5000);
    // 半关后可能还有在途的消息，一路读到到头为止
    变量 轮: 整数 = 0;
    当 (流到头了(尾) == 0 与 轮 < 10) {
        尾 = 流收(流, 3000);
        轮 = 轮 + 1;
    }
    记("半关后读到干净收尾", 流到头了(尾) == 1, "");
    记("收尾状态是 OK", 流的状态码(流) == 0,
       "码=" + 整数转字符串(流的状态码(流)) + " " + 流的说明(流));
    关掉流(流);

    // ── 客户端流的用法：连发不收，半关后再一起收 ──
    变量 流2: 整数 = 开流(连, "greet.Greeter/Chatter");
    变量 k: 整数 = 0;
    当 (k < 4) {
        流发(流2, 一条请求("批量" + 整数转字符串(k)));
        k = k + 1;
    }
    半关掉(流2);
    变量 收齐: 整数 = 0;
    当 (真) {
        变量 一条: 字符串 = 流收(流2, 5000);
        如果 (流到头了(一条) == 1) { 跳出; }
        如果 (字符串::字节长度(一条) > 0) { 收齐 = 收齐 + 1; }
    }
    记("连发 4 条半关后收齐", 收齐 == 4, 整数转字符串(收齐) + "/4");
    关掉流(流2);

    断开后端(连);
    IO.打印行("");
    IO.打印行("通过 " + 整数转字符串(通过) + " / 失败 " + 整数转字符串(失败));
}
