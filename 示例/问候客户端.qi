// qi 写的 gRPC 客户端 —— 打任意 gRPC 服务端。
//
//   # 打 Go 服务端（互通/go对照/服务端）
//   go run ./服务端 -addr 127.0.0.1:47821 &
//   GRPC_ADDR=127.0.0.1:47821 qi run 示例/问候客户端.qi
//
//   # 打我们自己的 qi 服务端也一样
//   GRPC_ADDR=127.0.0.1:47811 qi run 示例/问候客户端.qi
包 主程序;

导入 gRPC::{建服务, 连接后端, 连接后端TLS, 断开后端, 调用, 调用带元数据,
             设默认元数据, 是错误, 错误码, 错误说明};
导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 标准库.输入输出 作为 IO;

变量 通过: 整数 = 0;
变量 失败: 整数 = 0;

函数 记(名: 字符串, 好: 整数, 详情: 字符串) {
    如果 (好 == 1) {
        通过 = 通过 + 1;
        IO.打印行("  ✓ " + 名 + "  " + 详情);
    } 否则 {
        失败 = 失败 + 1;
        IO.打印行("  ✗ " + 名 + "  " + 详情);
    }
}

函数 取或默认(键: 字符串, 默认值: 字符串) : 字符串 {
    变量 设的: 字符串 = 系统.获取环境变量(键);
    如果 (字符串::字节长度(设的) > 0) { 返回 设的; }
    返回 默认值;
}

函数 入口() {
    变量 协议路径: 字符串 = 取或默认("GREET_PROTO", "协议/greet.proto");
    变量 地址: 字符串 = 取或默认("GRPC_ADDR", "127.0.0.1:47811");

    如果 (建服务(协议路径) == 0) {
        IO.打印行("加载不了 " + 协议路径);
        返回;
    }
    // 给了 CA 就走 TLS
    变量 CA: 字符串 = 系统.获取环境变量("GRPC_CA");
    变量 连: 整数 = 0 - 1;
    如果 (字符串::字节长度(CA) > 0) {
        连 = 连接后端TLS(地址, CA);
    } 否则 {
        连 = 连接后端(地址);
    }
    如果 (连 < 0) {
        IO.打印行("连不上 " + 地址);
        返回;
    }
    IO.打印行("连上 " + 地址);

    // ── 元数据：连接级默认 + 调用级 ──
    //
    // 服务端设了 REQUIRE_TOKEN 时才有鉴权拦截器；没设的话这几条只验
    // 「带了元数据不影响正常调用」。
    变量 令牌: 字符串 = 系统.获取环境变量("TOKEN");
    如果 (字符串::字节长度(令牌) > 0) {
        // 先不带令牌 —— 应当被拦
        变量 拦: 字符串 = 调用(连, "greet.Greeter/SayHello", "{\"name\":\"无票\"}");
        记("不带令牌被拦下", 错误码(拦) == 16,
           "码=" + 整数转字符串(错误码(拦)) + " " + 错误说明(拦));

        // 连接级默认：设一次，之后每次调用都带
        设默认元数据(连, "{\"authorization\":\"Bearer " + 令牌 + "\"}");
        变量 放: 字符串 = 调用(连, "greet.Greeter/SayHello", "{\"name\":\"有票\"}");
        记("设了默认元数据之后放行", 是错误(放) == 0, 错误说明(放));

        // 调用级盖掉连接级
        变量 盖: 字符串 = 调用带元数据(连, "greet.Greeter/SayHello",
                                     "{\"name\":\"假票\"}",
                                     "{\"authorization\":\"Bearer wrong\"}");
        记("调用级元数据盖掉连接级", 错误码(盖) == 16,
           "码=" + 整数转字符串(错误码(盖)));
    }


    // ── 正常调用 ──
    变量 回: 字符串 = 调用(连, "greet.Greeter/SayHello",
                          "{\"name\":\"qi\",\"times\":\"2\",\"tags\":[\"a\"]}");
    如果 (是错误(回) == 1) {
        记("一元调用", 0, "错 " + 整数转字符串(错误码(回)) + ": " + 错误说明(回));
    } 否则 {
        变量 对象: 整数 = J.解码(回);
        变量 话: 字符串 = J.获取字符串(对象, "message");
        记("一元调用", 字符串::字节长度(话) > 0, 话);
        // 嵌套字段要能读到
        变量 明细: 整数 = J.获取对象(对象, "detail");
        记("嵌套字段", 字符串::字节长度(J.获取字符串(明细, "server")) > 0,
           "server=" + J.获取字符串(明细, "server"));
        J.删除(对象);
    }

    // ── 服务端报错要能拿到状态码和中文消息 ──
    变量 错1: 字符串 = 调用(连, "greet.Greeter/SayHello", "{\"name\":\"\"}");
    记("空参数回 InvalidArgument(3)", 错误码(错1) == 3,
       "码=" + 整数转字符串(错误码(错1)) + " 说明=" + 错误说明(错1));

    // 两个服务端各自的拒绝路径：qi 服务端认「禁用」，Go 服务端认「拒绝」
    变量 错2: 字符串 = 调用(连, "greet.Greeter/SayHello", "{\"name\":\"拒绝\"}");
    变量 错3: 字符串 = 调用(连, "greet.Greeter/SayHello", "{\"name\":\"禁用\"}");
    变量 拒绝码: 整数 = 错误码(错2);
    如果 (拒绝码 == 0) { 拒绝码 = 错误码(错3); }
    变量 拒绝话: 字符串 = 错误说明(错2);
    如果 (字符串::字节长度(拒绝话) == 0) { 拒绝话 = 错误说明(错3); }
    // 中文消息穿过 trailers（服务端百分号编码、客户端解回来）
    记("拒绝路径带中文说明", 字符串::字节长度(拒绝话) > 0,
       "码=" + 整数转字符串(拒绝码) + " 说明=" + 拒绝话);

    // ── 没有的方法 ──
    变量 错4: 字符串 = 调用(连, "greet.Greeter/NoSuchMethod", "{}");
    记("协议里没有的方法在本地就拦下", 错误码(错4) == 12, 错误说明(错4));

    // ── 同一条连接反复调用（多路复用）──
    变量 i: 整数 = 0;
    变量 好几次: 整数 = 0;
    当 (i < 20) {
        变量 一次: 字符串 = 调用(连, "greet.Greeter/SayHello",
                               "{\"name\":\"第" + 整数转字符串(i) + "号\"}");
        如果 (是错误(一次) == 0) { 好几次 = 好几次 + 1; }
        i = i + 1;
    }
    记("同一条连接连打 20 次", 好几次 == 20, 整数转字符串(好几次) + "/20");

    断开后端(连);
    IO.打印行("");
    IO.打印行("通过 " + 整数转字符串(通过) + " / 失败 " + 整数转字符串(失败));
}
