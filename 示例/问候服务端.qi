// 最小的 gRPC 服务端 —— 用真的 gRPC 客户端打它：
//
//   qi run 示例/问候服务端.qi
//   grpcurl -plaintext -proto 协议/greet.proto \
//           -d '{"name":"世界","times":"3","mood":"MOOD_HAPPY"}' \
//           127.0.0.1:47811 greet.Greeter/SayHello
//
// 注意请求里的写法：times 是 **"3"**（int64 在 proto3 JSON 里是字符串）、
// mood 是 **"MOOD_HAPPY"**（枚举是名字）。这是 protobuf 官方映射，
// grpcurl / Go / Java 那边都这么认。
包 主程序;

导入 gRPC::{建服务, 注册, 注册流式, 跑, 跑TLS, 出错, 参数不对, 找不到,
             收一条, 发一条, 到头了, 收尾好了};
导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.时间 作为 时间;
导入 标准库.操作系统 作为 系统;
导入 标准库.输入输出 作为 IO;

函数 说你好(请求JSON: 字符串) : 字符串 {
    变量 请求: 整数 = J.解码(请求JSON);
    如果 (请求 <= 0) {
        返回 出错(参数不对(), "请求不是合法 JSON");
    }
    变量 名: 字符串 = J.获取字符串(请求, "name");
    // 这两个字段名是 JSON 映射之后的：.proto 里写 served_at，这里是 servedAt
    变量 遍数字符串: 字符串 = J.获取字符串(请求, "times");
    变量 心情: 字符串 = J.获取字符串(请求, "mood");
    J.删除(请求);

    如果 (字符串::字节长度(名) == 0) {
        返回 出错(参数不对(), "name 不能为空");
    }
    如果 (字符串::等于(名, "禁用") == 1) {
        // 走一条真实的错误路径，好验证 grpc-status 有没有正确回到客户端
        返回 出错(找不到(), "这个名字不给打招呼：" + 名);
    }

    变量 遍数: 整数 = 字符串转整数(遍数字符串);
    如果 (遍数 < 1) { 遍数 = 1; }
    如果 (遍数 > 5) { 遍数 = 5; }

    变量 话: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 遍数) {
        话 = 话 + "你好，" + 名 + "！";
        i = i + 1;
    }
    如果 (字符串::等于(心情, "MOOD_TIRED") == 1) {
        话 = 话 + "（早点休息）";
    }

    变量 明细: 整数 = J.创建对象();
    J.设置字符串(明细, "server", "qi-grpc");
    J.设置布尔(明细, "cached", 0);

    变量 回: 整数 = J.创建对象();
    J.设置字符串(回, "message", 话);
    // int64 出去也要是字符串
    J.设置字符串(回, "servedAt", 整数转字符串(时间.现在毫秒() / 1000));
    J.设置对象(回, "detail", 明细);
    变量 出: 字符串 = J.转字符串(回);
    J.删除(回);
    返回 出;
}

// 双向流：客户端发一条我们回一条，客户端发完半关，我们收尾。
//
// 三种流在这一层是同一件事 —— 收几条、发几条自己定。只想做服务端流就
// 收一条之后连发多条；只想做客户端流就收到头再发一条。
函数 唠嗑(调用: 整数) : 整数 {
    变量 第几条: 整数 = 0;
    当 (真) {
        变量 一条: 字符串 = 收一条(调用, 10000);
        // 客户端半关了 —— 该收尾了
        如果 (到头了(一条) == 1) { 跳出; }
        // 这一轮没消息，接着等（**不能当成结束**）
        如果 (字符串::字节长度(一条) == 0) { 继续; }

        变量 请求: 整数 = J.解码(一条);
        变量 名: 字符串 = J.获取字符串(请求, "name");
        J.删除(请求);
        第几条 = 第几条 + 1;

        变量 回: 整数 = J.创建对象();
        J.设置字符串(回, "message", "第 " + 整数转字符串(第几条) + " 声：你好，" + 名 + "！");
        J.设置字符串(回, "servedAt", 整数转字符串(时间.现在毫秒() / 1000));
        发一条(调用, J.转字符串(回));
        J.删除(回);
    }
    IO.打印行("唠嗑结束，一共回了 " + 整数转字符串(第几条) + " 条");
    返回 收尾好了(调用);
}

函数 协议路径() : 字符串 {
    变量 设的: 字符串 = 系统.获取环境变量("GREET_PROTO");
    如果 (字符串::字节长度(设的) > 0) { 返回 设的; }
    返回 "协议/greet.proto";
}

函数 端口() : 整数 {
    变量 设的: 字符串 = 系统.获取环境变量("PORT");
    如果 (字符串::字节长度(设的) > 0) { 返回 字符串转整数(设的); }
    返回 47811;
}

函数 入口() {
    如果 (建服务(协议路径()) == 0) {
        IO.打印行("起不来：加载不了 " + 协议路径());
        返回;
    }
    如果 (注册("greet.Greeter/SayHello", 说你好) == 0) {
        IO.打印行("注册失败");
        返回;
    }
    注册流式("greet.Greeter/Chatter", 唠嗑);
    // 给了证书就走 TLS，没给就明文 h2c
    变量 证书: 字符串 = 系统.获取环境变量("GRPC_CERT");
    变量 私钥: 字符串 = 系统.获取环境变量("GRPC_KEY");
    如果 (字符串::字节长度(证书) > 0 与 字符串::字节长度(私钥) > 0) {
        跑TLS("127.0.0.1", 端口(), 证书, 私钥);
        返回;
    }
    跑("127.0.0.1", 端口());
}
