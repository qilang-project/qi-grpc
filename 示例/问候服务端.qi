// 最小的 gRPC 服务端 —— 用真的 gRPC 客户端打它：
//
//   qi run 示例/问候服务端.qi
//   grpcurl -plaintext -proto 协议/greet.proto \
//           -d '{"name":"世界","times":"3","mood":"MOOD_HAPPY"}' \
//           127.0.0.1:47811 greet.Greeter/SayHello
//
// 注意请求里的写法：times 是 **"3"**（int64 在 proto3 JSON 里是字符串）、
// mood 是 **"MOOD_HAPPY"**（枚举是名字）。这是 protobuf 官方映射，
// grpcurl / Go / Java 那边都这么认。
包 主程序;

导入 gRPC::{建服务, 注册, 注册流式, 加拦截器, 跑, 跑TLS, 优雅停机, 出错, 参数不对, 找不到,
             收一条, 发一条, 到头了, 收尾好了, 收尾出错, 方法名, 剩余预算,
             资源耗尽, 没登录, 元数据, 设响应元数据, 还活着};
导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.时间 作为 时间;
导入 标准库.操作系统 作为 系统;
导入 标准库.输入输出 作为 IO;

函数 说你好(调用: 整数, 请求JSON: 字符串) : 字符串 {
    变量 请求: 整数 = J.解码(请求JSON);
    如果 (请求 <= 0) {
        返回 出错(参数不对(), "请求不是合法 JSON");
    }
    变量 名: 字符串 = J.获取字符串(请求, "name");
    // 这两个字段名是 JSON 映射之后的：.proto 里写 served_at，这里是 servedAt
    变量 遍数字符串: 字符串 = J.获取字符串(请求, "times");
    变量 心情: 字符串 = J.获取字符串(请求, "mood");
    J.删除(请求);

    如果 (字符串::字节长度(名) == 0) {
        返回 出错(参数不对(), "name 不能为空");
    }
    // 故意慢一会儿的路径，用来验 deadline 真的被执行
    如果 (字符串::等于(名, "慢") == 1) {
        时间.睡眠毫秒(3000);
        名 = "慢工出细活";
    }
    // 一边磨蹭一边看人还在不在 —— 走了就别算了
    如果 (字符串::等于(名, "看着走") == 1) {
        变量 转: 整数 = 0;
        当 (转 < 50) {
            时间.睡眠毫秒(100);
            如果 (还活着(调用) == 0) {
                IO.打印行("[发现] 对面走了，第 " + 整数转字符串(转) + " 圈就收工");
                返回 出错(资源耗尽(), "调用方已断开");
            }
            转 = 转 + 1;
        }
        名 = "等了五秒";
    }
    如果 (字符串::等于(名, "禁用") == 1) {
        // 走一条真实的错误路径，好验证 grpc-status 有没有正确回到客户端
        返回 出错(找不到(), "这个名字不给打招呼：" + 名);
    }

    变量 遍数: 整数 = 字符串转整数(遍数字符串);
    如果 (遍数 < 1) { 遍数 = 1; }
    如果 (遍数 > 5) { 遍数 = 5; }

    变量 话: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 遍数) {
        话 = 话 + "你好，" + 名 + "！";
        i = i + 1;
    }
    如果 (字符串::等于(心情, "MOOD_TIRED") == 1) {
        话 = 话 + "（早点休息）";
    }

    变量 明细: 整数 = J.创建对象();
    J.设置字符串(明细, "server", "qi-grpc");
    J.设置布尔(明细, "cached", 0);

    变量 回: 整数 = J.创建对象();
    J.设置字符串(回, "message", 话);
    // int64 出去也要是字符串
    J.设置字符串(回, "servedAt", 整数转字符串(时间.现在毫秒() / 1000));
    J.设置对象(回, "detail", 明细);
    变量 出: 字符串 = J.转字符串(回);
    J.删除(回);
    返回 出;
}

// 双向流：客户端发一条我们回一条，客户端发完半关，我们收尾。
//
// 三种流在这一层是同一件事 —— 收几条、发几条自己定。只想做服务端流就
// 收一条之后连发多条；只想做客户端流就收到头再发一条。
函数 唠嗑(调用: 整数) : 整数 {
    变量 第几条: 整数 = 0;
    当 (真) {
        变量 一条: 字符串 = 收一条(调用, 10000);
        // 客户端半关了 —— 该收尾了
        如果 (到头了(一条) == 1) { 跳出; }
        // 这一轮没消息，接着等（**不能当成结束**）
        如果 (字符串::字节长度(一条) == 0) { 继续; }

        变量 请求: 整数 = J.解码(一条);
        变量 名: 字符串 = J.获取字符串(请求, "name");
        J.删除(请求);
        第几条 = 第几条 + 1;

        变量 回: 整数 = J.创建对象();
        J.设置字符串(回, "message", "第 " + 整数转字符串(第几条) + " 声：你好，" + 名 + "！");
        J.设置字符串(回, "servedAt", 整数转字符串(时间.现在毫秒() / 1000));
        发一条(调用, J.转字符串(回));
        J.删除(回);
    }
    IO.打印行("唠嗑结束，一共回了 " + 整数转字符串(第几条) + " 条");
    返回 收尾好了(调用);
}

// ── 拦截器：一元和流式都会经过 ──────────────────────────────────

// 记一行日志。放行前后各干一点活，这是「洋葱」形状的用处。
函数 记一笔(下一步: 函数(整数): 整数, 调用: 整数) : 整数 {
    变量 开始: 整数 = 时间.现在毫秒();
    变量 哪个: 字符串 = 方法名(调用);
    变量 结局: 整数 = 下一步(调用);
    IO.打印行("[调用] " + 哪个 + " 用了 "
             + 整数转字符串(时间.现在毫秒() - 开始) + " 毫秒");
    返回 结局;
}

// 鉴权：从元数据里读 authorization。**拦截器最主要的用途就是这个** ——
// 没有元数据的话它就只能打日志。
//
// 设了 REQUIRE_TOKEN 才启用，免得别的验收脚本都得改。
函数 要令牌(下一步: 函数(整数): 整数, 调用: 整数) : 整数 {
    变量 要的: 字符串 = 系统.获取环境变量("REQUIRE_TOKEN");
    如果 (字符串::字节长度(要的) == 0) {
        返回 下一步(调用);
    }
    变量 令牌: 字符串 = 元数据(调用, "authorization");
    如果 (字符串::等于(令牌, "Bearer " + 要的) == 0) {
        // 不调「下一步」= 拦住，处理函数根本不会跑
        返回 收尾出错(调用, 没登录(), "令牌不对");
    }
    // 自定义响应元数据：跟着 trailers 一起回去
    设响应元数据(调用, "x-served-by", "qi-grpc");
    返回 下一步(调用);
}

// 预算不够就别开工了 —— 干完也没人要。
// 不调「下一步」就是拦住，处理函数根本不会跑。
函数 预算够吗(下一步: 函数(整数): 整数, 调用: 整数) : 整数 {
    变量 剩: 整数 = 剩余预算(调用);
    如果 (剩 >= 0 与 剩 < 50) {
        IO.打印行("[拦下] 只剩 " + 整数转字符串(剩) + " 毫秒，不开工了");
        返回 收尾出错(调用, 资源耗尽(), "调用方给的时间不够了");
    }
    返回 下一步(调用);
}

// 多份 .proto 用逗号分隔。带 extension 的那份是给反射的扩展请求当靶子的。
函数 协议路径() : 字符串 {
    变量 设的: 字符串 = 系统.获取环境变量("GREET_PROTO");
    如果 (字符串::字节长度(设的) > 0) { 返回 设的; }
    返回 "协议/greet.proto";
}

函数 端口() : 整数 {
    变量 设的: 字符串 = 系统.获取环境变量("PORT");
    如果 (字符串::字节长度(设的) > 0) { 返回 字符串转整数(设的); }
    返回 47811;
}

函数 入口() {
    如果 (建服务(协议路径()) == 0) {
        IO.打印行("起不来：加载不了 " + 协议路径());
        返回;
    }
    如果 (注册("greet.Greeter/SayHello", 说你好) == 0) {
        IO.打印行("注册失败");
        返回;
    }
    注册流式("greet.Greeter/Chatter", 唠嗑);

    // 后加的先跑：进来的顺序是 预算够吗 → 记一笔 → 处理函数
    加拦截器(记一笔);
    加拦截器(预算够吗);
    加拦截器(要令牌);
    // 给了证书就走 TLS，没给就明文 h2c
    变量 证书: 字符串 = 系统.获取环境变量("GRPC_CERT");
    变量 私钥: 字符串 = 系统.获取环境变量("GRPC_KEY");
    如果 (字符串::字节长度(证书) > 0 与 字符串::字节长度(私钥) > 0) {
        跑TLS("127.0.0.1", 端口(), 证书, 私钥);
        返回;
    }
    跑("127.0.0.1", 端口());
}
