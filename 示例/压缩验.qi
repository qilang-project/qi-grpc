包 主程序;
导入 gRPC::{建服务, 连接后端, 断开后端, 调用, 是错误, 错误说明};
导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 标准库.输入输出 作为 IO;

函数 入口() {
    建服务(系统.获取环境变量("GREET_PROTO"));
    变量 连: 整数 = 连接后端(系统.获取环境变量("GRPC_ADDR"));
    如果 (连 < 0) { IO.打印行("连不上"); 返回; }

    // 名字堆到 3000 字节以上，两边都会真压
    变量 长名: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 200) { 长名 = 长名 + "超长的名字"; i = i + 1; }

    变量 请求: 整数 = J.创建对象();
    J.设置字符串(请求, "name", 长名);
    J.设置字符串(请求, "times", "5");
    变量 回: 字符串 = 调用(连, "greet.Greeter/SayHello", J.转字符串(请求));
    J.删除(请求);

    如果 (是错误(回) == 1) {
        IO.打印行("  ✗ " + 错误说明(回));
    } 否则 {
        变量 对象: 整数 = J.解码(回);
        变量 话: 字符串 = J.获取字符串(对象, "message");
        变量 期望长: 整数 = 5 * (字符串::字节长度("你好，") + 字符串::字节长度(长名) + 字符串::字节长度("！"));
        如果 (字符串::字节长度(话) == 期望长) {
            IO.打印行("  ✓ 双向 gzip：请求 " + 整数转字符串(字符串::字节长度(长名))
                     + " 字节、响应 " + 整数转字符串(字符串::字节长度(话)) + " 字节，内容逐字节对");
        } 否则 {
            IO.打印行("  ✗ 长度不对：" + 整数转字符串(字符串::字节长度(话))
                     + " 期望 " + 整数转字符串(期望长));
        }
        J.删除(对象);
    }
    断开后端(连);
}
